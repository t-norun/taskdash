      await refreshAll().catch(() => {});
    };

    const tick = async () => {
      if (cancelled) return;

      try {
        const res = await authenticatedFetch(
          apiUrl(`/api/tasks/check-match?submissionId=${encodeURIComponent(sid)}`),
          { method: "GET" }
        );
        const data = await res.json().catch(() => ({}));

        // ✅ forfeited を見たら即終了（待機・ポーリング停止・pending掃除）
        if (data?.status === "forfeited" || data?.forfeited === true) {
          await hardClearAndRefresh();
          return;
        }

        if (!res.ok) {
          if (Math.random() < 0.25) await refreshAll().catch(() => {});
          scheduleNext(1500);
          return;
        }

        // ============================================================
        // 笨・縺薙％縺御ｻ雁屓縺ｮ縲悟髪荳縺ｮ菫ｮ豁｣縲搾ｼ喃orfeited 繧定ｦ九◆繧臥ｵゆｺ・・逅・
        // - API縺ｯ status:"forfeited" / statusCompat:"forfeited" / forfeited:true 縺ｮ蜿ｯ閭ｽ諤ｧ
        // - 隕九◆迸ｬ髢薙↓繝昴・繝ｪ繝ｳ繧ｰ蛛懈ｭ｢ & pending謗・勁 & Home繧偵・繝ｬ繧､蜿ｯ閭ｽ縺ｫ謌ｻ縺・
        // ============================================================
        const st = String(data?.status ?? data?.statusCompat ?? "").toLowerCase();
        const isForfeited = data?.forfeited === true || st === "forfeited";
        if (isForfeited) {
          // 莉･蠕・tick 繧貞屓縺輔↑縺・ｼ医％縺ｮ effect 蜀・□縺醍｢ｺ螳溘↓豁｢繧√ｋ・・
          cancelled = true;
          await hardClearAndRefresh();
          return;
        }

        if (data?.matchId) {
          setPending((prev) => {
            const next = {
              ...(prev || {}),
              submissionId: sid,
              status: "MATCHED",
              matchId: data.matchId,
              savedAt: startedAtRef.current || Date.now(),
            };
            savePendingObj(next);
            return next;
          });

          try {
            await authenticatedFetch(apiUrl("/api/tasks/settle"), {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ matchId: data.matchId }),
            }).then((r) => r.json().catch(() => ({})));
          } catch {}

          const recent = await loadRecent();
          const chk = isSubmissionDoneInRecent(recent?.results ?? [], sid);
          if (chk?.done) {
            await hardClearAndRefresh();
            return;
          }

          scheduleNext(data?.nextPollMs ?? 1200);
          return;
        }

        if (Math.random() < 0.35) {
          const recent = await loadRecent();
          const chk = isSubmissionDoneInRecent(recent?.results ?? [], sid);
          if (chk?.done) {
            await hardClearAndRefresh();
            return;
          }
        }

        scheduleNext(data?.nextPollMs ?? null);
      } catch {
        scheduleNext(1500);
      }
    };

    tick();

    return () => {
      cancelled = true;
      stop();
      if (stopPendingRef.current === stop) stopPendingRef.current = null;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [refreshAll, loadRecent]);

  // --- Recent Results 蛻晏屓 ---
  useEffect(() => {
    let alive = true;
    (async () => {
      if (!alive) return;
      await loadRecent();
    })();
    return () => {
      alive = false;
    };
  }, [loadRecent]);

  // 謚輔￡蜃ｺ縺玲､懃衍繝ｻ繝ｪ繝ｭ繝ｼ繝峨・謌ｻ繧九・focus縺ｧ蠢・★譛譁ｰ蜿門ｾ・
  useEffect(() => {
    const run = () => {
      loadRecent();
      loadData();
    };

    run();

    const onFocus = () => run();
    const onVis = () => {
      if (document.visibilityState === "visible") run();
    };

    window.addEventListener("focus", onFocus);
    document.addEventListener("visibilitychange", onVis);
    window.addEventListener("pageshow", onFocus);

    return () => {
      window.removeEventListener("focus", onFocus);
      document.removeEventListener("visibilitychange", onVis);
      window.removeEventListener("pageshow", onFocus);
    };
  }, [loadRecent, loadData]);

  // ===== mount effect =====
  useEffect(() => {
    let alive = true;

    (async () => {
      const ok = await checkAuth();
      if (!ok) {
        if (alive) setLoading(false);
        return;
      }
      if (!alive) return;

      // pending 陦ｨ遉ｺ縺縺大叉蠕ｩ蜈・
      const p = parsePending(loadPendingRaw());
      if (p && p.submissionId) {
        const startedAt = Number.isFinite(Number(p?.savedAt)) ? Number(p.savedAt) : Date.now();
        setPending({
          submissionId: p.submissionId,
          status: p.matchId ? "MATCHED" : "WAITING",
          matchId: p.matchId || null,
          priceUsd: p.priceUsd ?? null,
          stakeCents: p.stakeCents ?? null,
          savedAt: startedAt,
        });
        startedAtRef.current = startedAt;
        setPendingElapsedMs(Date.now() - startedAt);
      }

      await refreshAll();
      await loadWaitingCounts();

      if (alive) setLoading(false);
    })();

    return () => {
      alive = false;
    };
  }, [checkAuth, refreshAll, loadWaitingCounts]);

  // ===== render =====
  if (loading && !user) {
    return (
      <div className="min-h-screen bg-white font-inter flex items-center justify-center">
        <div className="text-[14px] text-[#7A7A7A]">Loading...</div>
      </div>
    );
  }

  const pendingElapsedText = pending ? fmtElapsed(pendingElapsedMs) : null;
  const nextPollText =
    pending && nextPollInMs != null ? `${Math.max(1, Math.ceil(nextPollInMs / 1000))}s` : "—";

  return (
    <div className="min-h-screen bg-white font-inter">
      <div className="border-b border-[#EDEDED]">
        <div className="max-w-[800px] mx-auto px-6 h-[64px] flex items-center justify-between">
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 border-4 border-[#2563FF] rounded-full"></div>
            <span className="text-[16px] font-semibold text-[#2B2B2B]">Task Dash</span>
          </div>

          <div className="flex items-center gap-4">
            <a href="/admin" className="text-[13px] text-[#7A7A7A] hover:text-[#2B2B2B]">
              Admin
            </a>
            <button
              onClick={handleLogout}
              className="flex items-center gap-2 text-[13px] text-[#7A7A7A] hover:text-[#2B2B2B]"
            >
              <LogOut size={16} />
              Logout
            </button>
          </div>
        </div>
      </div>

      <div className="max-w-[800px] mx-auto px-6 py-8">
        {/* pending submission 繧ｫ繝ｼ繝会ｼ・submit逕ｻ髱｢縺ｸ陦後￥・・*/}
        {pending ? (
          <div className="bg-white border border-[#F1F1F1] rounded-xl p-6 mb-6">
            <div className="flex items-center justify-between gap-4">
              <div>
                <div className="text-[14px] font-semibold text-[#2B2B2B]">
                  {pending.status === "WAITING" ? "竢ｳ Waiting窶ｦ (not matched yet)" : "笨・Matched"}
                </div>

                <div className="text-[12px] text-[#7A7A7A] mt-1">
                  submissionId: {pending.submissionId}
                  {pending.matchId ? ` / matchId: ${pending.matchId}` : ""}
                </div>

                <div className="text-[12px] text-[#7A7A7A] mt-1">
                  elapsed: <strong>{pendingElapsedText}</strong>
                  {nextPollText ? (
                    <>
                      {" "}
                      / next check in: <strong>{nextPollText}</strong>
                    </>
                  ) : null}
                </div>
              </div>

              <div className="flex gap-2">
                {pending.matchId ? (
                  <button
                    onClick={() =>
                      (window.location.href = `/match?matchId=${encodeURIComponent(pending.matchId)}`)
                    }
                    className="px-4 h-[40px] bg-[#10B981] text-white text-[13px] font-semibold rounded-lg"
                  >
                    Open
                  </button>
                ) : (
                  <button
                    onClick={submitPending}
                    disabled={submittingPending}
                    className="px-4 h-[40px] bg-[#2563FF] text-white text-[13px] font-semibold rounded-lg disabled:opacity-50"
                  >
                    {submittingPending ? "Opening..." : "Go to Submit Screen"}
                  </button>
                )}

                <button
                  onClick={discardPending}
                  disabled={submittingPending}
                  className="px-4 h-[40px] bg-white border border-[#E5E5E5] text-[#2B2B2B] text-[13px] font-semibold rounded-lg disabled:opacity-50"
                  title="繝ｭ繝ｼ繧ｫ繝ｫ縺ｮ蠕・ｩ溯｡ｨ遉ｺ繧呈ｶ医＠縺ｾ縺呻ｼ医し繝ｼ繝仙・縺ｮ蠕・ｩ溘・邯咏ｶ壹＠縺ｦOK・・
                >
                  Discard
                </button>
              </div>
            </div>
          </div>
        ) : null}

        {/* Balance Card */}
        <div className="bg-white border border-[#F1F1F1] rounded-xl p-8 mb-6">
          <div className="flex items-center justify-between mb-6">
            <div className="flex-1">
              <div className="text-[13px] text-[#7A7A7A] mb-1">Current Balance</div>
              <div className="text-[32px] font-semibold text-[#2B2B2B]">{formatUsdFromCents(available)}</div>
              {reserved > 0 ? (
                <div className="text-[12px] text-[#F59E0B] mt-1">
                  {formatUsdFromCents(reserved)} reserved (withdrawal pending)
                </div>
              ) : null}
            </div>

            <div className="flex flex-col gap-2">
              <button
                onClick={() => setShowAddFundsModal(true)}
                className="flex items-center gap-2 px-4 py-2 bg-[#10B981] text-white text-[13px] font-semibold rounded-lg hover:bg-[#059669]"
              >
                <Plus size={16} />
                Add Funds
              </button>
              <button
                onClick={() => setShowWithdrawModal(true)}
                className="flex items-center gap-2 px-4 py-2 bg-white border border-[#E5E5E5] text-[#2B2B2B] text-[13px] font-semibold rounded-lg hover:border-[#2563FF]"
              >
                Withdraw
              </button>
            </div>
          </div>

          {/* Select Task Price */}
          <div className="mb-6">
            <div className="text-[14px] font-medium text-[#2B2B2B] mb-3">Select Task Price</div>

            <div className="grid grid-cols-5 gap-2">
              {PRICE_OPTIONS.map((price) => {
                const waiting = waitingCounts[String(price)] || 0;
                const disabled = availableUsd < price;

                return (
                  <button
                    key={price}
                    onClick={() => setSelectedPrice(price)}
                    disabled={disabled}
                    className={`h-[60px] rounded-lg text-[18px] font-semibold transition-all relative ${
                      selectedPrice === price
                        ? "bg-[#2563FF] text-white border-2 border-[#2563FF]"
                        : disabled
                        ? "bg-[#F5F5F5] text-[#C3C3C3] border-2 border-[#E5E5E5] cursor-not-allowed"
                        : "bg-white text-[#2B2B2B] border-2 border-[#E5E5E5] hover:border-[#2563FF]"
                    }`}
                  >
                    ${price}
                    {waiting > 0 ? (
                      <div className="absolute -top-1 -right-1 w-5 h-5 bg-[#10B981] rounded-full flex items-center justify-center">
                        <span className="text-[10px] font-bold text-white">{waiting}</span>
                      </div>
                    ) : null}
                  </button>
                );
              })}
            </div>
          </div>

          <button
            onClick={handleAcceptJob}
            disabled={!selectedPrice || availableUsd < Number(selectedPrice)}
            className="w-full h-[56px] bg-[#2563FF] text-white text-[16px] font-semibold rounded-lg disabled:opacity-50 disabled:cursor-not-allowed hover:bg-[#1E40AF]"
          >
            {!selectedPrice
              ? "Select Price First"
              : waitingCounts[String(selectedPrice)] > 0
              ? `Accept Job ($${Number(selectedPrice).toFixed(2)}) - ${waitingCounts[String(selectedPrice)]} waiting`
              : `Accept Job ($${Number(selectedPrice).toFixed(2)})`}
          </button>

          {selectedPrice && availableUsd < Number(selectedPrice) ? (
            <p className="text-[12px] text-[#C33] text-center mt-3">
              Insufficient balance. Contact admin for more funds.
            </p>
          ) : null}
        </div>

        {/* Recent Results */}
        <div className="bg-white border border-[#F1F1F1] rounded-xl p-6 mb-6">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-[16px] font-semibold text-[#2B2B2B]">Recent Results</h2>
            <button
              onClick={() => refreshAll().catch(() => {})}
              className="text-[12px] px-3 py-1 border border-[#E5E5E5] rounded-lg hover:border-[#2563FF] hover:text-[#2563FF]"
            >
              Refresh
            </button>
          </div>

          {/* 笘・waiting荳ｭ縺ｧ繧・Recent Results 縺ｮ蜈磯ｭ縺ｫ蠢・★蜃ｺ縺・*/}
          {pending ? (
            <div style={{ borderTop: "1px solid #eee", paddingTop: 10, marginBottom: 10 }}>
              <div style={{ fontWeight: 800 }}>{pending.status === "WAITING" ? "竢ｳ Waiting窶ｦ" : "笨・Matched"}</div>
              <div style={{ fontSize: 12, opacity: 0.75, marginTop: 2 }}>submission: {pending.submissionId}</div>
              <div style={{ fontSize: 12, opacity: 0.75, marginTop: 2 }}>
                elapsed: <strong>{pendingElapsedText}</strong>
                {nextPollText ? (
                  <>
                    {" "}
                    / next check in: <strong>{nextPollText}</strong>
                  </>
                ) : null}
              </div>
              {pending.matchId ? (
                <div style={{ fontSize: 12, opacity: 0.75, marginTop: 2 }}>matchId: {pending.matchId}</div>
              ) : null}
            </div>
          ) : null}

          {recentLoading ? (
            <div style={{ opacity: 0.7 }}>Loading...</div>
          ) : recentMatches.length === 0 ? (
            <div style={{ opacity: 0.7 }}>{recentError ? `Error: ${recentError}` : "No completed jobs yet."}</div>
          ) : (
            <div style={{ display: "grid", gap: 10 }}>
              {recentMatches.map((r) => {
                const myMs = r?.my?.timeMs ?? null;
                const oppMs = r?.opponent?.timeMs ?? null;

                const mySec = myMs != null ? (Number(myMs) / 1000).toFixed(3) : "-";
                const oppSec = oppMs != null ? (Number(oppMs) / 1000).toFixed(3) : "-";

                const myScore = r?.my?.score ?? null;
                const oppScore = r?.opponent?.score ?? null;

                const diff = myScore != null && oppScore != null ? Number(myScore) - Number(oppScore) : null;

                const outcomeLabel =
                  r?.outcome === "win"
                    ? "Victory"
                    : r?.outcome === "lose"
                    ? "Defeat"
                    : r?.outcome === "tie"
                    ? "Draw"
                    : "Pending";

                const stakeUsd = r?.stakeCents != null ? (Number(r.stakeCents) / 100).toFixed(2) : "0.00";

                const rewardCents =
                  r?.outcome === "win"
                    ? r?.payoutWinnerCents ?? 0
                    : r?.outcome === "lose"
                    ? r?.payoutLoserCents ?? 0
                    : r?.payoutWinnerCents ?? 0;

                const rewardUsd = (Number(rewardCents) / 100).toFixed(2);

                const scoreText =
                  myScore != null && oppScore != null
                    ? `Score: ${myScore} vs ${oppScore}${diff != null ? ` (${diff > 0 ? "+" : ""}${diff})` : ""}`
                    : "Score: --";

                const timeText = `Time: ${mySec}s vs ${oppSec}s`;
                const whenText = r?.settledAt ? new Date(r.settledAt).toLocaleString() : "";

                return (
                  <div key={r.matchId} style={{ borderTop: "1px solid #eee", paddingTop: 10 }}>
                    <div style={{ fontWeight: 800 }}>{outcomeLabel} 窶・${stakeUsd} task</div>

                    <div style={{ fontWeight: 700, marginTop: 2 }}>Reward: ${rewardUsd}</div>

                    <div style={{ fontSize: 12, opacity: 0.75, marginTop: 4 }}>{scoreText}</div>
                    <div style={{ fontSize: 12, opacity: 0.75, marginTop: 2 }}>{timeText}</div>

                    <div style={{ fontSize: 12, opacity: 0.6, marginTop: 2 }}>{whenText}</div>
                  </div>
                );
              })}
            </div>
          )}
        </div>

        <a
          href="/rules"
          className="w-full h-[48px] border border-[#E5E5E5] rounded-lg text-[14px] font-medium text-[#7A7A7A] flex items-center justify-center gap-2 hover:border-[#2563FF] hover:text-[#2563FF]"
        >
          <BookOpen size={16} />
          How Task Dash Works
        </a>
      </div>

      {/* Add Funds Modal */}
      {showAddFundsModal ? (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-xl p-8 max-w-[400px] w-full">
            <h3 className="text-[18px] font-semibold text-[#2B2B2B] mb-4">Add Funds via PayPal</h3>
            <p className="text-[13px] text-[#7A7A7A] mb-4">You'll be redirected to PayPal to complete the payment.</p>

            <div className="mb-6">
              <label className="text-[13px] font-medium text-[#2B2B2B] mb-2 block">Amount (USD)</label>
              <input
                type="number"
                min="1"
                max="500"
                value={addFundsAmount}
                onChange={(e) => setAddFundsAmount(parseFloat(e.target.value) || 1)}
                className="w-full h-[48px] px-4 border-2 border-[#E5E5E5] rounded-lg text-[16px] focus:border-[#2563FF] focus:outline-none"
              />
              <p className="text-[11px] text-[#9B9B9B] mt-1">Minimum: $1 | Maximum: $500</p>
            </div>

            <div className="flex gap-3">
              <button
                onClick={() => {
                  setShowAddFundsModal(false);
                  setAddFundsAmount(10);
                }}
                disabled={processingPayment}
                className="flex-1 h-[48px] border border-[#E5E5E5] rounded-lg text-[14px] font-medium text-[#7A7A7A] disabled:opacity-50"
              >
                Cancel
              </button>
              <button
                onClick={handleAddFunds}
                disabled={processingPayment}
                className="flex-1 h-[48px] bg-[#2563FF] text-white text-[14px] font-semibold rounded-lg disabled:opacity-50"
              >
                {processingPayment ? "Processing..." : `Add $${Number(addFundsAmount).toFixed(2)}`}
              </button>
            </div>
          </div>
        </div>
      ) : null}

      {/* Withdraw Modal */}
      {showWithdrawModal ? (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-xl p-8 max-w-[400px] w-full">
            <h3 className="text-[18px] font-semibold text-[#2B2B2B] mb-4">Withdraw to PayPal</h3>
            <p className="text-[13px] text-[#7A7A7A] mb-4">
              Available balance: <strong>{formatUsdFromCents(available)}</strong>
            </p>

            <div className="mb-4">
              <label className="text-[13px] font-medium text-[#2B2B2B] mb-2 block">Amount (USD)</label>
              <input
                type="number"
                min="0.01"
                step="0.01"
                value={withdrawAmount}
                onChange={(e) => setWithdrawAmount(e.target.value)}
                className="w-full h-[48px] px-4 border-2 border-[#E5E5E5] rounded-lg text-[16px] focus:border-[#2563FF] focus:outline-none"
                placeholder="Enter amount"
              />
            </div>

            <div className="mb-6">
              <label className="text-[13px] font-medium text-[#2B2B2B] mb-2 block">PayPal Email</label>
              <input
                type="email"
                value={paypalEmail}
                onChange={(e) => setPaypalEmail(e.target.value)}
                className="w-full h-[48px] px-4 border-2 border-[#E5E5E5] rounded-lg text-[16px] focus:border-[#2563FF] focus:outline-none"
                placeholder="your@email.com"
              />
            </div>

            <div className="flex gap-3">
              <button
                onClick={() => {
                  setShowWithdrawModal(false);
                  setWithdrawAmount("");
                  setPaypalEmail("");
                }}
                disabled={processingWithdraw}
                className="flex-1 h-[48px] border border-[#E5E5E5] rounded-lg text-[14px] font-medium text-[#7A7A7A] disabled:opacity-50"
              >
                Cancel
              </button>
              <button
                onClick={handleWithdraw}
                disabled={processingWithdraw}
                className="flex-1 h-[48px] bg-[#2563FF] text-white text-[14px] font-semibold rounded-lg disabled:opacity-50"
              >
                {processingWithdraw ? "Processing..." : "Withdraw"}
              </button>
            </div>
          </div>
        </div>
      ) : null}

      {/* Confirm Modal */}
      {showConfirmModal ? (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-xl p-8 max-w-[400px] w-full">
            <h3 className="text-[18px] font-semibold text-[#2B2B2B] mb-4">Accept Job?</h3>
            <p className="text-[14px] text-[#7A7A7A] mb-6">
              Task price: <strong>${Number(selectedPrice || 0).toFixed(2)}</strong>
              <br />
              Your balance after: <strong>${(availableUsd - Number(selectedPrice || 0)).toFixed(2)}</strong>
            </p>
            <div className="flex gap-3">
              <button
                type="button"
                onClick={() => setShowConfirmModal(false)}
                className="flex-1 h-[48px] border border-[#E5E5E5] rounded-lg text-[14px] font-medium text-[#7A7A7A]"
              >
                Cancel
              </button>
              <button
                type="button"
                onClick={confirmAcceptJob}
                className="flex-1 h-[48px] bg-[#2563FF] text-white text-[14px] font-semibold rounded-lg"
              >
                Confirm
              </button>
            </div>
          </div>
        </div>
      ) : null}
    </div>
  );
}

