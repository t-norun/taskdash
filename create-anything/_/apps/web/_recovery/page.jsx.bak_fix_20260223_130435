const API_ORIGIN = "http://localhost:3000";
function apiUrl(p) {
  if (!p) return API_ORIGIN;
  if (typeof p === "string" && p.startsWith("http")) return p;
  return `${API_ORIGIN}${String(p).startsWith("/") ? "" : "/"}${p}`;
}

