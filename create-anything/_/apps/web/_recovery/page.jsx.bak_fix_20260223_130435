// ===== helpers =====
function loadPendingRaw() {
  // 蜆ｪ蜈磯・ｽ・
  // 1) taskdash_waiting・井ｻ雁屓縺ｮ螳滉ｽ難ｼ・
  // 2) pendingSubmission・井ｺ呈鋤・・
  try {
    const w = localStorage.getItem(WAITING_KEY);
    if (w) return w;
  } catch {}

  try {
    const p = localStorage.getItem(PENDING_KEY);
    if (p) return p;
  } catch {}

  return null;
}

/**
 * pending 縺ｯ "譁・ｭ怜・submissionId" 縺ｨ "JSON" 縺ｮ荳｡譁ｹ繧定ｨｱ螳ｹ・磯℃蜴ｻ縺ｮ螳溯｣・ｷｮ蛻・精蜿趣ｼ・
 * - 譁・ｭ怜・: "fb2e..."
 * - JSON: {"submissionId":"...","priceUsd":10,...} 繧・{"attemptId":"..."} 遲・
 */
function parsePending(raw) {
  if (!raw) return null;

  // 縺ｾ縺・JSON 繧定ｩｦ縺・
  try {
    const obj = JSON.parse(raw);
    if (obj && typeof obj === "object") {
      const sid = obj.submissionId || obj.attemptId || obj.id || null;
      if (sid && typeof sid === "string") {
        return {
          submissionId: sid,
          priceUsd: obj.priceUsd ?? null,
          stakeCents: obj.stakeCents ?? null,
          savedAt: obj.savedAt ?? null,
          status: obj.status || "WAITING",
          matchId: obj.matchId || null,

          // submit逕ｻ髱｢莠呈鋤・亥ｭ伜惠縺吶ｌ縺ｰ貂ｩ蟄假ｼ・
          attemptId: obj.attemptId ?? null,
          orderedNumbers: obj.orderedNumbers ?? null,
          timeMs: obj.timeMs ?? null,
          taskId: obj.taskId ?? null,
        };
      }
    }
  } catch {
    // raw 縺後◆縺縺ｮ譁・ｭ怜・UUID縺ｮ蝣ｴ蜷医・縺薙％縺ｫ譚･繧・
  }

  // JSON縺倥ｃ縺ｪ縺・ｼ昴◎縺ｮ縺ｾ縺ｾ submissionId 縺ｨ縺励※謇ｱ縺・
  if (typeof raw === "string" && raw.length > 0) {
    return {
      submissionId: raw,
      priceUsd: null,
      stakeCents: null,
      savedAt: null,
      status: "WAITING",
      matchId: null,
      attemptId: null,
      orderedNumbers: null,
      timeMs: null,
      taskId: null,
    };
  }

  return null;
}

function savePendingObj(p) {
  try {
    if (!p) return;
    // waiting迥ｶ諷九・ taskdash_waiting 縺ｫ菫晏ｭ假ｼ・ubmit蛛ｴ縺ｨ謠・∴繧具ｼ・
    localStorage.setItem(WAITING_KEY, JSON.stringify(p));
    // 莠呈鋤縺ｮ縺溘ａ pendingSubmission 縺ｫ繧ょ・繧後※縺翫￥・医←縺｣縺｡隕九※繧ょ虚縺擾ｼ・
    localStorage.setItem(PENDING_KEY, JSON.stringify(p));
  } catch {}
}

function clearPendingStorage() {
  try {
    localStorage.removeItem(WAITING_KEY);
    localStorage.removeItem(PENDING_KEY);
    localStorage.removeItem(LAST_SUBMIT_KEY);
    for (const k of LEGACY_SUBMISSION_KEYS) localStorage.removeItem(k);
  } catch {}
}

function pad2(n) {
  return String(Math.max(0, Math.trunc(Number(n) || 0))).padStart(2, "0");
}
function fmtElapsed(ms) {
  const s = Math.max(0, Math.floor((Number(ms) || 0) / 1000));
  const m = Math.floor(s / 60);
  const r = s % 60;
  return `${m}:${pad2(r)}`;
}

// 辟｡譛滄剞蠕・ｩ・+ 閾ｪ蜍輔ヰ繝・け繧ｪ繝包ｼ医け繝ｩ繧､繧｢繝ｳ繝亥・・・
function computeBackoffMs(elapsedMs) {
  const e = Math.max(0, Number(elapsedMs) || 0);
  if (e < 20_000) return 1000; // 0-20s
  if (e < 120_000) return 2000; // 20s-2m
  if (e < 600_000) return 5000; // 2m-10m
  if (e < 1_800_000) return 10_000; // 10m-30m
  return 15_000; // 30m+
}

// recent-results 縺ｮ荳ｭ縺九ｉ縲後％縺ｮ submission 縺檎ｵゅｏ縺｣縺ｦ繧九°縲阪ｒ蛻､螳・
function isSubmissionDoneInRecent(results, submissionId) {
  if (!Array.isArray(results) || !submissionId)
    return { done: false, status: null, matchId: null };

  for (const r of results) {
    const mySid = r?.my?.submissionId;
    const oppSid = r?.opponent?.submissionId;
    const matchId = r?.matchId || null;

    // my蛛ｴ荳閾ｴ
    if (mySid === submissionId) {
      const st = r?.my?.raw?.status || null; // "SETTLED" 遲・
      if (st === "SETTLED" || st === "CANCELLED")
        return { done: true, status: st, matchId };
      if (r?.settledAt) return { done: true, status: "SETTLED", matchId };
      return { done: false, status: st, matchId };
    }

    // opponent蛛ｴ荳閾ｴ・亥ｿｵ縺ｮ縺溘ａ・・
    if (oppSid === submissionId) {
      const st = r?.opponent?.raw?.status || null;
      if (st === "SETTLED" || st === "CANCELLED")
        return { done: true, status: st, matchId };
      if (r?.settledAt) return { done: true, status: "SETTLED", matchId };
      return { done: false, status: st, matchId };
    }
  }

  return { done: false, status: null, matchId: null };
}

