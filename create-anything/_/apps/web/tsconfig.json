{
  "include": [
    "**/*.{ts,tsx,js,jsx}",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*",
    "./src/global.d.ts"
  ],
  "exclude": ["node_modules", "dist", "build"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],

    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    "rootDirs": [".", "./.react-router/types"],

    "allowJs": true,
    "checkJs": false,

    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
